  # 10. Thesaurus - Rôle Commanditaire (uniquement le skos:prefLabel)
<#ThesaurusCommanditaire>
  a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$"
  ] ;

  rr:subjectMap [
    rr:constant <http://data.culture.fr/thesaurus/resource/ark:/67717/T513-32837>
  ] ;

  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:constant "Commanditaire" ; rr:language "fr" ]
  ] .