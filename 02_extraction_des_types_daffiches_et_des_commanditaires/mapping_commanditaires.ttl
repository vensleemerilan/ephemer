@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix eph: <http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix adb: <http://data.soduco.fr/def/annuaire#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.

# 1. Record Principal
<#recordMap>
  a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$"
  ] ;
  rr:subjectMap [
    rr:template "http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/record/{object_number}" ;
    rr:class rico:Record
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:type ;
    rr:objectMap [ rml:reference "type_affiche" ]
  ] .

# 2. Agent Personne (rico:Person)
<#MappingCommanditairePersonne>
  a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.personnes[*]"
  ] ;
  rr:subjectMap [
    rr:template "http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/agent/{nom_norm}";
    rr:class rico:Person
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:name ;
    rr:objectMap [ rml:reference "nom" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate adb:address ;
    rr:objectMap [ rml:reference "adresse" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "nom" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rml:reference "categorie" ]
  ];
   rr:predicateObjectMap [
    rr:predicate rdfs:comment ;
    rr:objectMap [ rml:reference "explication" ]
  ].

# 3. Agent Organisation (rico:CorporateBody)
<#MappingCommanditaireOrg>
  a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.organisations[*]"
  ] ;
  rr:subjectMap [
    rr:template "http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/corporatebody/{nom_norm}";
    rr:class rico:CorporateBody
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:name ;
    rr:objectMap [ rml:reference "nom" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate adb:address ;
    rr:objectMap [ rml:reference "adresse" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "nom" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:type ;
    rr:objectMap [ rml:reference "categorie" ]
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:comment ;
    rr:objectMap [ rml:reference "explication" ]
  ]. 

