# 6. Relation de création (lie le Record à l'entité concernée)
<#MappingRelationCommanditairePer>
  a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data.json" ;
    rml:referenceFormulation ql:JSONPath ;
    # On inclut Personne, Organisation
    rml:iterator "$.personnes[*]"
  ] ;
  rr:subjectMap [
    rr:template "http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/commande/per/{object_number}" ;
    rr:class rico:CreationRelation
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:withCreationRole ;
    rr:object <http://data.culture.fr/thesaurus/resource/ark:/67717/T513-32837>
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:relationHasSource ;
    rr:objectMap [
      rr:template "http://rdf.geohistoricaldata.org/id/museeCarnavalet/ephemeres/record/{object_number}"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rico:relationHasTarget ;
    rr:objectMap [
      # Pointe vers l'URI de l'agent ou du lieu
      rr:parentTriplesMap <#MappingCommanditairePersonne>
    ]
  ] .

